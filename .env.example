# PostgreSQL
# Compose uses postgres:5432 internally; DATABASE_HOST/PORT are for host-side access.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=weft
DATABASE_USER=weft
DATABASE_PASSWORD=replace-with-a-local-development-password

# Optional (default: false)
# DATABASE_SSL=false

# Discord
DISCORD_TOKEN=replace-with-a-development-bot-token
DISCORD_APPLICATION_ID=replace-with-a-development-application-id

# Guild-scoped command registration only (not needed with --global)
# DISCORD_GUILD_ID=replace-with-a-development-guild-id

# Optional runtime settings (defaults shown)
# LOG_LEVEL=info
# HEALTH_PORT=3000

# PostgreSQL integration tests only (all six required; never use production)
# TEST_DATABASE_HOST=127.0.0.1
# TEST_DATABASE_PORT=5432
# TEST_DATABASE_NAME=weft_integration_test
# TEST_DATABASE_USER=weft_test
# TEST_DATABASE_PASSWORD=replace-with-a-local-test-password
# TEST_DATABASE_SSL=false
